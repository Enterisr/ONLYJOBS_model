{
  "manifest_version": 3,
  "name": "LinkedIn Job Filter",
  "version": "1.0",
  "description": "Automatically hides non-job posts from your LinkedIn feed using on-device AI, keeping only job listings visible. All processing happens in your browser — no data ever leaves your device.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "offscreen"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://*.huggingface.co/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/transformers.min.js",
        "vendor/ort-wasm-simd.wasm",
        "vendor/ort-wasm.wasm",
        "classifier.json",
        "offscreen.html"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
