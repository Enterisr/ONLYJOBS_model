{
  "manifest_version": 3,
  "name": "LinkedIn Job Filter",
  "version": "1.0",
  "description": "Hides non-job posts from your LinkedIn feed",
  "permissions": ["storage", "offscreen"],
  "host_permissions": ["https://www.linkedin.com/*", "http://localhost:*/*", "https://*.huggingface.co/*", "https://dog.ceo/*", "https://api.thecatapi.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*", "http://localhost:*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources":